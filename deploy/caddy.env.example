# Copy to /etc/caddy/caddy.env on the Pi and make it root-readable only.
# The service loads this file before adapting deploy/Caddyfile.

# The DuckDNS subdomain whose A record points to the Pi's reserved LAN address.
POKER_DOMAIN=your-subdomain.duckdns.org

# The account token shown by DuckDNS. Never commit the real value.
DUCKDNS_API_TOKEN=replace-with-your-duckdns-token
