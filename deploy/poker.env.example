# Copy to /etc/poker/poker.env on the Pi (chmod 600, owned by the poker user).
# Referenced by deploy/poker.service's EnvironmentFile=.

# Caddy is the LAN-facing service. Keep Node on loopback so the HTTPS front
# door is the only player-facing origin.
HOST=127.0.0.1

# Caddy owns the public 80/443 listeners; the backend stays on its unprivileged
# loopback port.
PORT=3000

# Root for durable Room recordings — one directory per Room ID, holding
# room.json plus a context/commands/events triplet per hand. The service unit
# grants poker write access to this state directory.
#
# Recording is a Room invariant: leaving this unset does not disable it, it
# falls back to ./recordings inside the release directory. The server refuses
# to start if the root will not take a write.
RECORDINGS_DIR=/var/lib/poker/recordings
